{
  "name": "enodorim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "From molecule to smell: an interactive olfactory receptor simulator (DIFACQUIM, UNAM)",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data": ".venv/bin/python -m scripts.pipeline.build",
    "benchmark": ".venv/bin/python -m scripts.pipeline.benchmark_models",
    "report": ".venv/bin/python -m scripts.report.benchmark_report && latexmk -pdf -cd reports/benchmark_report.tex"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@rdkit/rdkit": "^2026.9.1",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "jsme-editor": "^2024.4.29",
    "molstar": "^5.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
